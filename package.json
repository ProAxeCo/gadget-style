{
  "name": "gadget-style",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .husky",
    "dev": "vite --host",
    "build": "pnpm check && pnpm sitemap && vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && pnpm prerender",
    "prerender": "tsx scripts/prerender.ts",
    "sitemap": "tsx scripts/generate-sitemap.ts",
    "start": "NODE_ENV=production node dist/index.js",
    "preview": "vite preview --host",
    "check": "tsc --noEmit && pnpm run check:data",
    "check:data": "tsx scripts/validate-data.ts",
    "check:data:report": "tsx scripts/validate-data.ts > audit-report.txt 2>&1 || true",
    "report:placeholders": "tsx scripts/report-placeholders.ts",
    "report:externals": "tsx scripts/report-externals.ts",
    "fix:urls": "tsx scripts/fix-affiliate-urls.ts",
    "mirror:images": "tsx scripts/mirror-images.ts --apply",
    "fix:counts": "tsx scripts/fix-category-counts.ts",
    "scrape:gf": "tsx scripts/scrape-gadgetflow.ts",
    "ingest:gf": "tsx scripts/ingest-gadgetflow.ts",
    "gf:sync": "tsx scripts/gf-sync.ts",
    "drafts:list": "tsx scripts/list-drafts.ts",
    "drafts:prices": "tsx scripts/scrape-draft-prices.ts",
    "drafts:promote": "tsx scripts/promote-drafts.ts",
    "product:remove": "tsx scripts/remove-products.ts",
    "links:check": "tsx scripts/check-links.ts",
    "gf:refine": "tsx scripts/refine-products.ts",
    "amazon:discover": "tsx scripts/amazon-discover.ts",
    "tnt:sync": "tsx scripts/tnt-sync.ts",
    "brands:audit": "tsx scripts/audit-brand-assets.ts",
    "brands:imagery": "tsx scripts/source-brand-imagery.ts",
    "brands:logos": "tsx scripts/source-brand-logos.ts",
    "social:oauth": "tsx scripts/social-oauth-setup.ts",
    "social:post": "tsx scripts/post-product.ts",
    "social:queue": "tsx scripts/social-queue.ts",
    "write:descriptions": "tsx scripts/write-descriptions.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "framer-motion": "^12.23.22",
    "lucide-react": "^0.453.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.3",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "puppeteer": "^25.8.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3",
    "vite": "^7.1.7"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "pnpm": {
    "patchedDependencies": {
      "wouter@3.7.1": "patches/wouter@3.7.1.patch"
    },
    "overrides": {
      "tailwindcss>nanoid": "3.3.7"
    },
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild"
    ]
  }
}